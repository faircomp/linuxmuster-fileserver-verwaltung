#!/usr/bin/make -f
# linuxmuster-fileserver-verwaltung: architecture-independent scripts and
# configuration templates, placed by debian/install. Nothing is compiled or
# tested at build time, so the dh_auto_* steps are disabled; this also keeps
# debhelper from running the top-level Makefile, which only wraps
# dpkg-buildpackage.

%:
	dh $@

override_dh_auto_build override_dh_auto_test override_dh_auto_install override_dh_auto_clean:
	@:
