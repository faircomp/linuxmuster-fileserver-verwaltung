# debhelper build artefacts
debian/.debhelper/
debian/files
debian/debhelper-build-stamp
debian/linuxmuster-fileserver-verwaltung/
debian/*.substvars
debian/*.log

# dpkg-buildpackage writes these one level above the source tree, but keep the
# patterns here in case anyone builds with a different layout.
*.deb
*.buildinfo
*.changes
*.tar.xz
*.dsc

# Python bytecode from local syntax checks
__pycache__/
*.pyc

# crabbox failure captures - lokale Debug-Artefakte, niemals versionieren
.crabbox/
