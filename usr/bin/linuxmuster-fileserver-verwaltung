#!/usr/bin/env python3

#########################################################################
#
# linuxmuster-fileserver-verwaltung
#
# Sets up a dedicated administration ("Verwaltung") fileserver for a
# linuxmuster.net 7.3 installation: joins the Samba Active Directory as a
# domain member and publishes a single share whose access control is
# managed from Windows.
#
# Derived from linuxmuster-fileserver by Netzint GmbH (Lukas Spitznagel).
#
#########################################################################

import argparse
import configparser
import os
import shutil
import socket
import stat
import subprocess
import sys
import tempfile

from getpass import getpass

TEMPLATE_DIR = "/var/lib/linuxmuster-fileserver-verwaltung"
CONFIG_PATH = "/etc/linuxmuster-fileserver-verwaltung/share.conf"

# Well-known SID of NT AUTHORITY\SYSTEM. Used literally so that seeding the
# ACL does not depend on the display language of the domain controller.
SID_SYSTEM = "S-1-5-18"

GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
RESET = "\033[0m"

BANNER = r"""
=======================================================================
  linuxmuster.net  .  Verwaltungs-Fileserver

  Dedizierter Fileserver fuer die Schulverwaltung.
  Rechte werden unter Windows vergeben, nicht von sophomorix.
=======================================================================
"""


class SetupError(Exception):
    """Raised when a step fails in a way that must abort the run."""


# ---------------------------------------------------------------------------
# process helpers
# ---------------------------------------------------------------------------


def run(command, check=False):
    """Execute a command and return the CompletedProcess."""
    result = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        # Several checks below match on English output of the Samba tools
        # ("Join is OK", "Domain Controller"). Those strings are translatable,
        # so pin the locale instead of hoping no message catalogue is present.
        env={**os.environ, "LC_ALL": "C", "LANG": "C"},
        # Nothing here is interactive. Without this a tool that unexpectedly
        # prompts for a password would hang the run with no output.
        stdin=subprocess.DEVNULL,
    )
    if check and result.returncode != 0:
        raise SetupError(
            "Befehl fehlgeschlagen: %s\n%s" % (" ".join(command), out(result))
        )
    return result


def out(result):
    """Return the combined output of a CompletedProcess as text."""
    return (result.stdout + result.stderr).decode(errors="replace").strip()


def stdout_of(result):
    """Return only stdout - use this whenever the output gets parsed."""
    return result.stdout.decode(errors="replace").strip()


def step(message):
    print("%-60s" % (message + " ..."), end="", flush=True)


def good(detail=""):
    print(GREEN + "OK" + RESET + (" " + detail if detail else ""))


def warn(detail=""):
    print(YELLOW + "WARNUNG" + RESET + (" " + detail if detail else ""))


def bad(detail=""):
    print(RED + "FEHLER" + RESET + (" " + detail if detail else ""))


def resolve_password(args, prompt):
    """
    Obtain the password from --password-file, --password, or interactively.

    --password-file is the option to prefer in scripts: a password passed as
    an argument is visible in the process list to every user on the machine
    and ends up in the shell history.
    """
    path = getattr(args, "password_file", None)
    if path:
        try:
            with open(path) as handle:
                password = handle.read().strip("\n")
        except OSError as error:
            raise SetupError("Kann %s nicht lesen: %s" % (path, error))
        if not password:
            raise SetupError("Die Datei %s ist leer." % path)
        return password
    if args.password:
        return args.password
    return getpass(prompt)


class AuthFile:
    """
    A short-lived credentials file for the Samba tools.

    Passing "-U user%password" would expose the password in the process list
    of every user on the machine for as long as the command runs, so all
    Samba calls that need credentials read them from this file instead.
    """

    def __init__(self, username, password, workgroup):
        self.username = username
        self.password = password
        self.workgroup = workgroup
        self.path = None

    def __enter__(self):
        handle, self.path = tempfile.mkstemp(prefix="lmn-verwaltung-", dir="/run")
        try:
            os.fchmod(handle, stat.S_IRUSR | stat.S_IWUSR)
            with os.fdopen(handle, "w") as credentials:
                credentials.write(
                    "username=%s\npassword=%s\ndomain=%s\n"
                    % (self.username, self.password, self.workgroup)
                )
        except OSError:
            # __exit__ never runs if __enter__ raises, so clean up here or the
            # file with the password stays behind.
            os.unlink(self.path)
            raise
        return self

    def __exit__(self, *_):
        if self.path and os.path.exists(self.path):
            os.unlink(self.path)
        return False

    @property
    def args(self):
        return ["-A", self.path]


# ---------------------------------------------------------------------------
# preflight
# ---------------------------------------------------------------------------


def check_root():
    if os.geteuid() != 0:
        sys.exit("Dieses Programm muss als root laufen.")


def check_not_the_school_server():
    """
    Refuse to run on the linuxmuster server or on any Active Directory DC.

    This is the most destructive mistake available: setup rewrites
    /etc/samba/smb.conf, /etc/krb5.conf and /etc/nsswitch.conf unconditionally
    and then tries to join the domain. On a domain controller that replaces
    the "server role = active directory domain controller" configuration along
    with the sysvol and netlogon shares - the domain would be gone, and with
    it every login in the school.

    A wrong hostname in an SSH session is all it takes, so this is checked
    before anything is read from the user and before the first file is
    written. There is deliberately no override flag: this machine is never a
    valid target.
    """
    reasons = []

    if os.path.exists("/var/lib/samba/private/sam.ldb"):
        reasons.append("/var/lib/samba/private/sam.ldb existiert (AD-Datenbank)")

    if os.path.exists("/etc/samba/smb.conf"):
        result = run(["/usr/bin/testparm", "-s", "--parameter-name", "server role"])
        if "domain controller" in stdout_of(result).lower():
            reasons.append("smb.conf meldet 'server role = domain controller'")

    for unit in ("samba-ad-dc.service", "samba.service"):
        if out(run(["/usr/bin/systemctl", "is-active", unit])) == "active":
            reasons.append("der Dienst %s laeuft" % unit)

    if os.path.isdir("/etc/linuxmuster/sophomorix"):
        reasons.append("/etc/linuxmuster/sophomorix existiert (linuxmuster-Server)")

    for binary in ("/usr/sbin/sophomorix-group", "/usr/sbin/sophomorix-repair"):
        if os.path.exists(binary):
            reasons.append("%s ist installiert" % binary)
            break

    if os.path.isdir("/srv/samba/schools") and os.listdir("/srv/samba/schools"):
        reasons.append("/srv/samba/schools enthaelt Daten")

    # An existing linuxmuster-fileserver is just as unsuitable, for a
    # different reason: it maps IDs with the autorid backend. Overwriting its
    # smb.conf with the rid backend used here changes every uid and gid on the
    # machine at once. The POSIX ownership of the outsourced school data would
    # no longer match, the POSIX-ACL hash stored inside each security.NTACL
    # would stop matching too, and Samba would then discard the NT ACLs and
    # rebuild the permissions from ownership that has become meaningless.
    installed = run(
        ["/usr/bin/dpkg-query", "-W", "-f=${Status}", "linuxmuster-fileserver"]
    )
    if "install ok installed" in stdout_of(installed):
        reasons.append("das Paket linuxmuster-fileserver ist installiert")

    if reasons:
        sys.exit(
            RED
            + "ABBRUCH: Dieser Rechner ist bereits Teil der "
            "linuxmuster-Installation.\n\n"
            + "\n".join("  - " + reason for reason in reasons)
            + "\n\nDer Verwaltungs-Fileserver gehoert auf eine EIGENE, frische "
            "Maschine.\nAuf einem Domaenencontroller wuerde das Setup die "
            "smb.conf ersetzen und die\nDomaene zerstoeren; auf einem "
            "bestehenden Fileserver wuerde die Umstellung\ndes ID-Mappings die "
            "Rechte der ausgelagerten Schuldaten unbrauchbar machen.\n"
            + RESET
        )


def check_hostname():
    """
    The NetBIOS name is limited to 15 characters and the domain join derives
    it from the hostname, so an over-long name breaks the join in a way that
    is tedious to diagnose afterwards.
    """
    hostname = socket.gethostname()
    if "." in hostname:
        raise SetupError(
            "Der Hostname '%s' enthaelt einen Punkt. Bitte einen kurzen "
            "Hostnamen setzen, z.B.:\n  hostnamectl set-hostname verwaltung01"
            % hostname
        )
    if len(hostname) > 15:
        raise SetupError(
            "Der Hostname '%s' ist %d Zeichen lang, NetBIOS erlaubt hoechstens 15."
            % (hostname, len(hostname))
        )
    return hostname


DNS_HINT = (
    "Dieser Server muss den AD-Domaenencontroller (den linuxmuster-Server) als\n"
    "DNS-Server verwenden - nicht die Firewall. Nur der DC beantwortet die\n"
    "_ldap._tcp-SRV-Eintraege, ohne die kein Domaenenbeitritt moeglich ist.\n"
    "Die offizielle Doku nennt an dieser Stelle faelschlich die OPNsense-Adresse;\n"
    "das ist die haeufigste Ursache fuer einen fehlgeschlagenen Join."
)


def check_dns(domain):
    try:
        socket.getaddrinfo(domain, None)
    except socket.gaierror as error:
        raise SetupError(
            "Die Domaene '%s' laesst sich nicht aufloesen (%s).\n\n%s"
            % (domain, error, DNS_HINT)
        )


def check_domain_controller():
    """
    Locate a domain controller the way the join will, and report its NetBIOS
    domain name.

    Resolving the domain name alone is not enough: the join needs the SRV
    records that only the AD DNS serves, so probe for a DC directly. The
    CLDAP reply also carries the pre-Windows-2000 domain name, which is the
    authoritative value for "workgroup" - deriving it from the first label of
    the DNS name is only a guess.
    """
    result = run(["/usr/bin/net", "ads", "lookup"])
    if result.returncode != 0 or "Domain Controller" not in out(result):
        raise SetupError(
            "Es wurde kein Domaenencontroller gefunden.\n\n%s\n\nAusgabe:\n%s"
            % (DNS_HINT, out(result))
        )

    for line in stdout_of(result).splitlines():
        if line.strip().startswith("Pre-Win2k Domain:"):
            return line.split(":", 1)[1].strip()
    return None


def check_time_sync():
    result = run(["/usr/bin/timedatectl", "show", "-p", "NTPSynchronized", "--value"])
    return out(result) == "yes"


def check_xattr_support(path):
    """
    NT ACLs live in the security.NTACL extended attribute. Without xattr
    support the whole permission model silently degrades to mode bits, so
    this is checked before anything is written.
    """
    probe = os.path.join(path, ".lmn-xattr-probe")
    try:
        with open(probe, "w"):
            pass
        return (
            run(["/usr/bin/setfattr", "-n", "security.lmnprobe", "-v", "1", probe]).returncode
            == 0
        )
    except OSError as error:
        raise SetupError("Kann unter %s nicht schreiben: %s" % (path, error))
    finally:
        if os.path.exists(probe):
            os.unlink(probe)


# ---------------------------------------------------------------------------
# configuration
# ---------------------------------------------------------------------------


def write_template(name, target, replacements):
    """Render a template from TEMPLATE_DIR, keeping a copy of the original."""
    source = os.path.join(TEMPLATE_DIR, name)
    if not os.path.exists(source):
        raise SetupError("Vorlage %s fehlt. Ist das Paket vollstaendig?" % source)

    with open(source, "r") as handle:
        content = handle.read()
    for placeholder, value in replacements.items():
        content = content.replace(placeholder, value)

    if os.path.exists(target) and not os.path.exists(target + ".lmn-orig"):
        shutil.copy2(target, target + ".lmn-orig")

    with open(target, "w") as handle:
        handle.write(content)


def configure(domain, workgroup, hostname):
    replacements = {
        "%%DOMAIN%%": domain,
        "%%HOSTNAME%%": hostname.upper(),
        "%%WORKGROUP%%": workgroup,
    }

    for template, target in (
        ("krb5.conf.example", "/etc/krb5.conf"),
        ("nsswitch.conf.example", "/etc/nsswitch.conf"),
        ("smb.conf.example", "/etc/samba/smb.conf"),
    ):
        step("Schreibe %s" % target)
        write_template(template, target, replacements)
        good()

    step("Pruefe die erzeugte smb.conf")
    result = run(["/usr/bin/testparm", "-s"])
    # testparm exits 0 even for semantic problems: an invalid idmap range or
    # an unknown parameter is reported on stderr and still yields success.
    # Checking the exit code alone would wave those through.
    complaints = [
        line
        for line in out(result).splitlines()
        if line.startswith("ERROR:") or "Unknown parameter encountered" in line
    ]
    if result.returncode != 0 or complaints:
        raise SetupError(
            "Die erzeugte smb.conf ist ungueltig:\n%s"
            % ("\n".join(complaints) if complaints else out(result))
        )
    good()


def get_workgroup():
    # testparm prints the value on stdout and its diagnostics on stderr, so
    # read stdout alone here - the combined output would end in a banner line.
    result = run(["/usr/bin/testparm", "-s", "--parameter-name", "workgroup"])
    value = stdout_of(result)
    if not value:
        raise SetupError(
            "Die Arbeitsgruppe laesst sich nicht aus /etc/samba/smb.conf lesen. "
            "Wurde 'setup' schon ausgefuehrt?"
        )
    return value


# ---------------------------------------------------------------------------
# persisted setup state
# ---------------------------------------------------------------------------
#
# The SIDs are recorded deliberately. If an access group is ever deleted and
# recreated in the AD, it comes back with a *new* SID while every NT ACL on
# the share still references the old one. The share then denies access even
# though "the group exists again", and nothing in the Windows dialog explains
# why. Comparing the current SID against the recorded one turns that silent
# failure into a plain error message.


def _parser():
    # optionxform keeps the AD spelling of group names intact, and disabling
    # interpolation stops configparser from choking on a "%" in a path.
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    return parser


def save_config(share, path, workgroup, groups, rights_group, admin_user):
    parser = _parser()
    parser["share"] = {
        "name": share,
        "path": path,
        "workgroup": workgroup,
        "rights_group": rights_group,
        "admin_user": admin_user or "",
    }
    parser["groups"] = {name: sid for name, sid in groups}

    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    with open(CONFIG_PATH, "w") as handle:
        parser.write(handle)
    os.chmod(CONFIG_PATH, 0o0644)


def load_config():
    if not os.path.exists(CONFIG_PATH):
        raise SetupError(
            "%s fehlt. Wurde 'setup' auf diesem Server schon ausgefuehrt?"
            % CONFIG_PATH
        )
    parser = _parser()
    parser.read(CONFIG_PATH)
    return parser


def check_group_sids(parser):
    """
    Compare the recorded SIDs against what winbind resolves right now.

    Returns a list of human readable problems; empty means everything matches.
    """
    problems = []
    for name, recorded in parser["groups"].items():
        result = run(["/usr/bin/wbinfo", "--name-to-sid", name])
        if result.returncode != 0:
            problems.append("%s existiert nicht mehr im AD" % name)
            continue
        current = out(result).split()[0]
        if current != recorded:
            problems.append(
                "%s hat eine neue SID (%s statt %s) - die Windows-Rechte "
                "zeigen auf die alte und greifen nicht mehr"
                % (name, current, recorded)
            )
    return problems


# ---------------------------------------------------------------------------
# domain
# ---------------------------------------------------------------------------


def already_joined():
    return "Join is OK" in out(run(["/usr/bin/net", "ads", "testjoin"]))


def join_domain(auth):
    step("Trete der Active Directory bei")
    if already_joined():
        good("(war bereits Mitglied)")
    else:
        result = run(["/usr/bin/net", "ads", "join"] + auth.args)
        if not already_joined():
            raise SetupError(
                "Domaenenbeitritt fehlgeschlagen:\n%s\n\n"
                "Haeufige Ursachen: das Konto '%s' hat keine Beitrittsrechte, "
                "die Uhr weicht um mehr als 5 Minuten ab, oder der Server steht "
                "nicht in der devices.csv." % (out(result), auth.username)
            )
        good()

    step("Erzeuge /etc/krb5.keytab")
    result = run(["/usr/bin/net", "ads", "keytab", "create"] + auth.args)
    if result.returncode == 0:
        good()
    else:
        warn("(%s)" % out(result).splitlines()[-1] if out(result) else "")


def restart_services():
    # nmbd only serves legacy NetBIOS name resolution. It is frequently masked
    # on a modern member server, and the share works without it, so it must not
    # be able to abort the setup.
    for service, required in (("smbd", True), ("winbind", True), ("nmbd", False)):
        step("Starte %s" % service)
        enabled = run(["/usr/bin/systemctl", "enable", service])
        result = run(["/usr/bin/systemctl", "restart", service])
        if result.returncode == 0 and enabled.returncode != 0:
            # Running now but not enabled means the share disappears at the
            # next reboot - too quiet a failure to report as success.
            warn("(laeuft, startet aber nicht automatisch mit)")
        elif result.returncode == 0:
            good()
        elif required:
            bad()
            raise SetupError("Dienst %s startet nicht:\n%s" % (service, out(result)))
        else:
            warn("(nicht aktiv - fuer die Freigabe nicht erforderlich)")


def ping_dc():
    step("Pruefe Verbindung zum Domaenencontroller")
    result = run(["/usr/bin/wbinfo", "--ping-dc"])
    if result.returncode != 0:
        raise SetupError(
            "winbind erreicht den Domaenencontroller nicht:\n%s" % out(result)
        )
    good()


def resolve_group(workgroup, group):
    """
    Resolve an AD group through winbind and return (qualified name, SID).

    A share that references a group which does not exist locks everyone out
    without any error message, so this is a hard failure.
    """
    qualified = "%s\\%s" % (workgroup, group)
    result = run(["/usr/bin/wbinfo", "--name-to-sid", qualified])
    if result.returncode != 0:
        raise SetupError(
            "Die AD-Gruppe '%s' ist nicht aufloesbar.\n"
            "Lege sie zuerst auf dem linuxmuster-Server an und starte danach "
            "erneut.\n%s" % (qualified, out(result))
        )
    # Output looks like "S-1-5-21-...-1234 SID_DOM_GROUP (2)".
    sid = out(result).split()[0]
    return qualified, sid


# ---------------------------------------------------------------------------
# share
# ---------------------------------------------------------------------------


def create_directory(path, workgroup, username):
    step("Lege %s an" % path)
    os.makedirs(path, exist_ok=True)
    good()

    step("Pruefe erweiterte Attribute (security-Namensraum)")
    if not check_xattr_support(path):
        raise SetupError(
            "Das Dateisystem unter %s speichert keine erweiterten Attribute.\n"
            "Ohne security.NTACL koennen die Windows-Rechte nicht abgelegt "
            "werden. Bei ext4 'user_xattr' pruefen, bei ZFS 'xattr=sa' und "
            "'acltype=posixacl' setzen." % path
        )
    good()

    # The share is served with "acl_xattr:ignore system acls = yes", so the
    # POSIX layer inside the share is deliberately not authoritative. The
    # share root is the one exception: the kernel still enforces its mode on
    # traversal. The group is Domain Users, which keeps every non-AD account
    # out while the NT ACL does the actual per-folder filtering.
    #
    # The owner has to be a DOMAIN account, and that is not cosmetic. Before
    # the first NT ACL exists, Samba synthesizes one that grants the owner and
    # SYSTEM only. With root as the owner that owner is S-1-22-1-0, a local
    # SID no domain account holds - so nobody has WRITE_DAC and the very first
    # "smbcacls --set" fails with NT_STATUS_ACCESS_DENIED. Making the account
    # that seeds the ACL the owner breaks that chicken-and-egg. Once the NT
    # ACL is stored, the POSIX owner no longer decides anything.
    set_root_posix(path, workgroup, username)


def set_root_posix(path, workgroup, username):
    """
    Give the share root a POSIX owner, group and mode that let the NT ACL do
    its job.

    Two separate reasons, both learned the hard way:

    * The owner must be a DOMAIN account. Before any NT ACL exists, Samba
      synthesizes one granting the owner and SYSTEM only; with root as owner
      that is S-1-22-1-0, a local SID no domain account holds, so the first
      "smbcacls --set" fails with NT_STATUS_ACCESS_DENIED.
    * The group must be Domain Users. The kernel enforces the mode on every
      path component no matter what Samba thinks, so a share root that is
      only group-readable by Domain Admins denies every ordinary user at
      chdir() time - before the NT ACL is ever consulted. The share would
      appear to work for administrators and be dead for everyone else.

    Mode 0770 keeps accounts that are not in the domain out entirely, which
    matters because "acl_xattr:ignore system acls = yes" makes the POSIX layer
    inside the share meaningless.
    """
    step("Setze Basisrechte auf %s" % path)
    owner = "%s\\%s" % (workgroup, username)
    group = "%s\\domain users" % workgroup
    result = run(["/usr/bin/chown", "%s:%s" % (owner, group), path])
    if result.returncode != 0:
        raise SetupError(
            "Kann den Besitzer von %s nicht auf '%s:%s' setzen:\n%s\n"
            "Loest winbind die Konten auf? Pruefe 'getent passwd %s'."
            % (path, owner, group, out(result), owner)
        )
    os.chmod(path, 0o0770)
    good()


SHARE_NAME_FORBIDDEN = set('%<>*?|/\\+=;:",')


def validate_share_name(share):
    """
    Reject share names that Samba considers invalid.

    "net conf addshare" checks this, but "net conf setparm" does not - and the
    code below falls back to setparm, so a bad name would silently produce a
    broken registry share while every step still reported success.
    """
    bad = sorted(SHARE_NAME_FORBIDDEN & set(share))
    if bad or not share:
        raise SetupError(
            "Der Freigabename '%s' ist ungueltig. Nicht erlaubt: %s"
            % (share, " ".join(bad) or "(leer)")
        )


def configure_share(share, path, workgroup, groups, admin_user):
    validate_share_name(share)
    step("Konfiguriere Freigabe [%s]" % share)
    run(["/usr/bin/net", "conf", "addshare", share, path])

    # Samba splits list parameters on whitespace as well as commas, so an
    # unquoted "Domain Admins" would become the two meaningless entries
    # "Domain" and "Admins" - and every login would be refused with nothing
    # in the log below level 10. Every entry therefore gets quoted.
    #
    # Domain Admins are always included: without them the smbcacls call that
    # seeds the ACL cannot even connect, and nobody could open the share in
    # Windows to set permissions in the first place.
    entries = ['@%s\\Domain Admins' % workgroup]
    entries += ["@" + group for group in groups]
    if admin_user:
        entries.append(admin_user)
    valid_users = ['"%s"' % entry for entry in entries]

    parameters = [
        ("comment", "Verwaltung"),
        ("path", path),
        ("read only", "no"),
        ("browseable", "yes"),
        # Users only see the objects their NT ACL actually grants them.
        # (Note: "access based share enum" would NOT do this - it evaluates
        # the share ACL from share_info.tdb, not the security descriptors on
        # the files, so it is deliberately not set here.)
        ("hide unreadable", "yes"),
        # A second gate in front of the NT ACL. Share-level and NT-level
        # permissions are independent; the more restrictive one wins.
        ("valid users", ", ".join(valid_users)),
        # Listing acl_xattr here is required: a share-level "vfs objects"
        # replaces the global value rather than adding to it.
        ("vfs objects", "acl_xattr"),
        # Only the NT ACL decides access. Without this, Samba keeps a
        # best-effort POSIX ACL in sync, stores a hash of it in the NTACL
        # blob, and silently discards the Windows permissions whenever that
        # hash stops matching - after a restore, a chmod or an rsync.
        ("acl_xattr:ignore system acls", "yes"),
        # If an object ever has no NT ACL, expose owner and SYSTEM only
        # instead of deriving open permissions from the mode bits.
        ("acl_xattr:default acl style", "windows"),
    ]
    for key, value in parameters:
        run(["/usr/bin/net", "conf", "setparm", share, key, value], check=True)

    # "admin users" bypasses every permission on the share, so a second run
    # without --admin-user has to actively remove it. net conf never drops a
    # parameter on its own, and leaving that one behind would silently keep a
    # full bypass in place.
    if admin_user:
        run(
            ["/usr/bin/net", "conf", "setparm", share, "admin users",
             '"%s"' % admin_user],
            check=True,
        )
    else:
        run(["/usr/bin/net", "conf", "delparm", share, "admin users"])
    good()


def seed_acl(share, workgroup, groups, auth, label="Setze Start-ACL auf der Freigabe"):
    """
    Write a restrictive baseline ACL on the share root.

    Everything beyond this is meant to happen in the Windows security dialog;
    this only establishes a sane starting point. It touches the share root
    only - propagating would wipe the per-folder permissions that are the
    whole point of this server.
    """
    step(label)

    admins = "%s\\Domain Admins" % workgroup
    entries = [
        "REVISION:1",
        "OWNER:%s" % admins,
        "GROUP:%s" % admins,
        "ACL:%s:ALLOWED/OI|CI/FULL" % SID_SYSTEM,
        "ACL:%s:ALLOWED/OI|CI/FULL" % admins,
    ]
    entries += ["ACL:%s:ALLOWED/OI|CI/CHANGE" % g for g in groups]

    result = run(
        ["/usr/bin/smbcacls", "//localhost/%s" % share, "/"]
        + auth.args
        + ["--set", ",".join(entries)]
    )
    if result.returncode != 0:
        warn("(spaeter unter Windows setzen)")
        print("    %s" % out(result).splitlines()[-1] if out(result) else "")
        return False
    good()
    return True


def grant_disk_operator(workgroup, group, auth):
    """
    SeDiskOperatorPrivilege lets a group edit share permissions and ACLs from
    the Windows Computer Management console. Members of Domain Admins inherit
    it from BUILTIN\\Administrators, so it only matters for delegated groups -
    and it is local to this server, not domain-wide.
    """
    target = "%s\\%s" % (workgroup, group)
    step("Erteile %s das Recht SeDiskOperatorPrivilege" % target)
    result = run(
        ["/usr/bin/net", "rpc", "rights", "grant", target, "SeDiskOperatorPrivilege"]
        + auth.args
    )
    if result.returncode != 0:
        warn("(%s)" % (out(result).splitlines()[-1] if out(result) else "unbekannt"))
        return False
    good()
    return True


FOLDER_FORBIDDEN = set('<>:"/\\|?*')


def create_folders(share, folders, auth):
    """
    Create the subfolders through SMB instead of on the filesystem.

    A directory made with os.makedirs has no NT ACL at all, and with
    "acl_xattr:default acl style = windows" Samba then exposes owner and
    SYSTEM only - the owner being root, which is no domain account. On top of
    that it keeps the local mode root:root 0755, because Samba's forced
    create/directory masks only apply to objects created over SMB. Such a
    folder is invisible (hide unreadable) and unwritable for everyone.

    Creating it through SMB lets Samba apply inheritance from the share root
    exactly the way Windows would. sophomorix uses the same trick.
    """
    if not folders:
        return
    step("Lege %d Unterordner an" % len(folders))
    for folder in folders:
        bad = sorted(FOLDER_FORBIDDEN & set(folder))
        if bad or folder in (".", "..") or not folder.strip():
            raise SetupError(
                "Unzulaessiger Ordnername '%s'. Nicht erlaubt: %s"
                % (folder, " ".join(bad) or "(leer bzw. . und ..)")
            )
        result = run(
            ["/usr/bin/smbclient", "//localhost/%s" % share]
            + auth.args
            + ["-c", 'mkdir "%s"' % folder]
        )
        # An existing directory is reported as an error; that is fine here.
        if (
            result.returncode != 0
            and "NT_STATUS_OBJECT_NAME_COLLISION" not in out(result)
        ):
            raise SetupError(
                "Kann den Ordner '%s' nicht anlegen:\n%s" % (folder, out(result))
            )
    good()


# ---------------------------------------------------------------------------
# subcommands
# ---------------------------------------------------------------------------


def cmd_setup(args):
    check_root()
    # Before the password prompt and before the first write.
    check_not_the_school_server()

    domain = args.domain.upper()
    workgroup = domain.split(".")[0]
    hostname = check_hostname()
    password = resolve_password(args, "Passwort fuer %s@%s: " % (args.username, domain))

    print()
    step("Pruefe Namensaufloesung fuer %s" % domain)
    check_dns(args.domain)
    good()

    step("Pruefe Zeitsynchronisation")
    if check_time_sync():
        good()
    else:
        warn("(NTP nicht synchron - Kerberos scheitert dann)")

    validate_share_name(args.share)
    configure(domain, workgroup, hostname)

    # Only meaningful once smb.conf names the realm, so this runs after
    # configure() and before the join it is meant to protect.
    step("Suche einen Domaenencontroller")
    netbios_domain = check_domain_controller()
    good("(NetBIOS-Domaene: %s)" % netbios_domain if netbios_domain else "")

    # The NetBIOS domain name does not have to be the first label of the DNS
    # name. If it differs, everything derived from the guess is wrong at once:
    # "workgroup", the "idmap config <WG>" section - which would leave every
    # domain account in the tdb fallback range instead of the rid range - and
    # the username map. Rewrite the configuration with the authoritative value.
    if netbios_domain and netbios_domain.upper() != workgroup:
        print()
        print(
            YELLOW
            + "Die NetBIOS-Domaene lautet '%s', nicht '%s' wie aus dem "
            "DNS-Namen abgeleitet.\nDie Konfiguration wird damit neu "
            "geschrieben." % (netbios_domain.upper(), workgroup)
            + RESET
        )
        workgroup = netbios_domain.upper()
        configure(domain, workgroup, hostname)

    with AuthFile(args.username, password, workgroup) as auth:
        join_domain(auth)
        restart_services()
        ping_dc()

        resolved = [resolve_group(workgroup, g) for g in args.group]
        groups = [name for name, _ in resolved]
        admin_user = "%s\\administrator" % workgroup if args.admin_user else None

        create_directory(args.path, workgroup, args.username)
        configure_share(args.share, args.path, workgroup, groups, admin_user)

        step("Lade Samba-Konfiguration neu")
        run(["/usr/bin/smbcontrol", "all", "reload-config"], check=True)
        good()

        # Always seed, even without -g. Without an NT ACL the share root would
        # fall back to "owner and SYSTEM only" - and the owner is root, which
        # is no domain account, so not even Domain Admins could get in.
        seeded = seed_acl(args.share, workgroup, groups, auth)
        if seeded:
            # "smbcacls --set" writes the descriptor's OWNER and GROUP through
            # to the POSIX layer, which just turned the share root into
            # domain admins:domain admins. Left alone, the kernel would deny
            # every non-administrator at chdir() before the NT ACL is even
            # looked at.
            set_root_posix(args.path, workgroup, args.username)
        # Only now: the folders inherit the ACL that was just written.
        create_folders(args.share, args.folder, auth)
        granted = grant_disk_operator(workgroup, args.rights_group, auth)

    step("Schreibe %s" % CONFIG_PATH)
    save_config(
        args.share, args.path, workgroup, resolved, args.rights_group, admin_user
    )
    good()

    fqdn = "%s.%s" % (hostname, domain.lower())

    print()
    print(GREEN + "Setup abgeschlossen." + RESET)
    print()
    print("  Freigabe   \\\\%s\\%s" % (fqdn, args.share))
    print("  Pfad       %s" % args.path)
    print("  Zugriff    %s" % (", ".join(groups) if groups else "(keine Gruppe gesetzt)"))
    print()

    if not groups:
        print(
            YELLOW
            + "Es wurde keine Zugriffsgruppe angegeben (-g). Zugriff haben\n"
            "damit ausschliesslich die Domaenen-Admins. Lege eine Gruppe an\n"
            "und fuege sie unter Windows in die Rechte ein, oder wiederhole\n"
            "das Setup mit -g." + RESET
        )
        print()
    if not seeded:
        print(
            YELLOW
            + "Die Start-ACL konnte nicht gesetzt werden. Bis das nachgeholt\n"
            "ist, hat die Freigabewurzel keine gueltige NT-ACL und niemand\n"
            "kommt hinein. Erneut versuchen mit:" + RESET
        )
        print("  linuxmuster-fileserver-verwaltung repair-acls --force")
        print()
    if not granted:
        print(YELLOW + "SeDiskOperatorPrivilege wurde nicht erteilt. Manuell:" + RESET)
        print(
            '  net rpc rights grant "%s\\%s" SeDiskOperatorPrivilege -U %s'
            % (workgroup, args.rights_group, args.username)
        )
        print()

    print("Naechster Schritt: an einem Windows-Client als Domaenen-Admin")
    print("  \\\\%s\\%s  oeffnen" % (fqdn, args.share))
    print("  -> Eigenschaften -> Sicherheit -> Erweitert")
    if seeded:
        print("Eine restriktive Start-ACL ist bereits gesetzt.")
    print("Details: /usr/share/doc/linuxmuster-fileserver-verwaltung")


def cmd_status(args):
    # "net conf" reads the Samba registry and getfattr reads the security
    # namespace; both need root. Without it the checks would not fail, they
    # would quietly report the wrong thing.
    check_root()
    print()
    ok = True

    for service, required in (("smbd", True), ("winbind", True), ("nmbd", False)):
        step("Dienst %s" % service)
        if out(run(["/usr/bin/systemctl", "is-active", service])) == "active":
            good()
        elif required:
            bad()
            ok = False
        else:
            warn("(optional)")

    step("Domaenenmitgliedschaft")
    if already_joined():
        good()
    else:
        bad("(net ads testjoin schlaegt fehl)")
        ok = False

    step("Domaenencontroller erreichbar")
    if run(["/usr/bin/wbinfo", "--ping-dc"]).returncode == 0:
        good()
    else:
        bad()
        ok = False

    try:
        workgroup = get_workgroup()
    except SetupError:
        workgroup = None

    if workgroup:
        step("Namensaufloesung (%s\\Domain Users)" % workgroup)
        # "wbinfo -u" is useless as a probe here because the configuration
        # deliberately turns enumeration off; resolving a known group is the
        # check that actually means something.
        if run(
            ["/usr/bin/wbinfo", "--name-to-sid", "%s\\Domain Users" % workgroup]
        ).returncode == 0:
            good()
        else:
            bad()
            ok = False

    step("Freigabe [%s] konfiguriert" % args.share)
    shares = stdout_of(run(["/usr/bin/net", "conf", "listshares"])).splitlines()
    if args.share in [line.strip() for line in shares]:
        good()
    else:
        bad()
        ok = False

    path = stdout_of(run(["/usr/bin/net", "conf", "getparm", args.share, "path"]))
    if path and os.path.isdir(path):
        step("NT-ACL auf %s vorhanden" % path)
        result = run(["/usr/bin/getfattr", "-m", "security.NTACL", "-d", path])
        if "security.NTACL" in out(result):
            good()
        else:
            warn("(noch nie unter Windows bearbeitet)")

    step("Zeitsynchronisation")
    if check_time_sync():
        good()
    else:
        warn("(NTP nicht synchron)")

    try:
        parser = load_config()
    except SetupError:
        parser = None

    if parser and parser.has_section("groups"):
        step("Zugriffsgruppen unveraendert")
        problems = check_group_sids(parser)
        if problems:
            bad()
            for problem in problems:
                print("    %s" % problem)
            print(
                "    Reparatur: linuxmuster-fileserver-verwaltung repair-acls"
            )
            ok = False
        else:
            good()

    print()
    if not ok:
        sys.exit(1)


def cmd_show(args):
    check_root()
    path = stdout_of(run(["/usr/bin/net", "conf", "getparm", args.share, "path"]))
    if not path or not os.path.isdir(path):
        sys.exit("Freigabe [%s] hat keinen gueltigen Pfad." % args.share)

    print("--- Freigabe-Definition (Registry) ---")
    print(out(run(["/usr/bin/net", "conf", "showshare", args.share])))
    print()
    print("--- Freigabeberechtigungen (share_info.tdb) ---")
    print(out(run(["/usr/bin/sharesec", args.share, "-v"])))
    print()
    print("--- POSIX (nur der Freigabe-Wurzel, sonst nicht massgeblich) ---")
    print(out(run(["/usr/bin/getfacl", "-p", path])))
    print()
    print("--- NT-ACL der Freigabewurzel ---")
    # samba-tool decodes the descriptor; getfattr would only print the raw
    # base64 blob, which tells nobody anything.
    decoded = run(["/usr/bin/samba-tool", "ntacl", "get", "--as-sddl", path])
    if decoded.returncode == 0 and stdout_of(decoded):
        print(stdout_of(decoded))
    else:
        present = run(["/usr/bin/getfattr", "-m", "security.NTACL", "-d", path])
        if "security.NTACL" in out(present):
            print("gesetzt (nicht dekodierbar auf diesem System)")
            print("Lesbar anzeigen:  smbcacls //localhost/%s / -U <admin>" % args.share)
        else:
            print("(kein NT-ACL gesetzt)")

    count = run(
        [
            "/usr/bin/getfattr",
            "-R",
            "-d",
            "-m",
            r"^security\.NTACL$",
            "--absolute-names",
            path,
        ]
    )
    objects = sum(
        1 for line in stdout_of(count).splitlines() if line.startswith("# file:")
    )
    print()
    print("Objekte mit eigener NT-ACL unterhalb der Freigabe: %d" % objects)


def cmd_repair_acls(args):
    """
    Re-apply the baseline ACL and re-record the group SIDs.

    The case this exists for: an access group was deleted and recreated in the
    AD. It looks unchanged in every dialog, but its SID is new, so the ACLs
    that reference the old SID quietly stop granting anything. Re-setting the
    baseline by name repairs the share root; per-folder permissions further
    down still have to be redone in Windows, which is why this deliberately
    does not propagate.
    """
    check_root()
    parser = load_config()
    share = parser["share"]["name"]
    workgroup = parser["share"]["workgroup"]
    groups = list(parser["groups"].keys())

    print()
    problems = check_group_sids(parser)
    if not problems and not args.force:
        print("Die Zugriffsgruppen sind unveraendert - nichts zu tun.")
        print("Mit --force wird die Basis-ACL trotzdem neu gesetzt.")
        return
    for problem in problems:
        print(YELLOW + "  %s" % problem + RESET)
    print()

    missing = [g for g in groups if run(["/usr/bin/wbinfo", "--name-to-sid", g]).returncode != 0]
    if missing:
        raise SetupError(
            "Diese Gruppen fehlen im AD und muessen zuerst wieder angelegt "
            "werden:\n  %s" % "\n  ".join(missing)
        )

    password = resolve_password(args, "Passwort fuer %s: " % args.username)
    with AuthFile(args.username, password, workgroup) as auth:
        if not seed_acl(
            share, workgroup, groups, auth, label="Setze Basis-ACL neu"
        ):
            raise SetupError("Die Basis-ACL konnte nicht gesetzt werden.")
        set_root_posix(parser["share"]["path"], workgroup, args.username)

    resolved = [resolve_group(workgroup, g.split("\\", 1)[-1]) for g in groups]
    save_config(
        share,
        parser["share"]["path"],
        workgroup,
        resolved,
        parser["share"]["rights_group"],
        parser["share"].get("admin_user") or None,
    )

    print()
    print(GREEN + "Basis-ACL erneuert." + RESET)
    print(
        "Rechte auf Unterordnern muessen unter Windows nachgezogen werden - "
        "sie verweisen weiterhin auf die alte SID."
    )


def share_path(args):
    """Return the share path from the saved configuration or the registry."""
    try:
        return load_config()["share"]["path"]
    except (SetupError, KeyError):
        path = stdout_of(
            run(["/usr/bin/net", "conf", "getparm", args.share, "path"])
        )
        if not path or not os.path.isdir(path):
            raise SetupError("Freigabe [%s] hat keinen gueltigen Pfad." % args.share)
        return path


def cmd_save_acl(args):
    """
    Back up every NT ACL below the share as an xattr dump.

    Not smbcacls: its --save/--restore/--recurse options do not exist in the
    Samba 4.19 that Ubuntu 24.04 ships - they were silently rejected and left
    an empty file behind. Dumping security.NTACL covers every object in one
    pass, needs no credentials, and restores byte for byte.
    """
    check_root()
    path = share_path(args)

    handle = os.open(args.file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o0600)
    try:
        result = subprocess.run(
            [
                "/usr/bin/getfattr",
                "-R",
                "-d",
                "-m",
                r"^security\.NTACL$",
                "--absolute-names",
                path,
            ],
            stdout=handle,
            stderr=subprocess.PIPE,
            env={**os.environ, "LC_ALL": "C"},
            stdin=subprocess.DEVNULL,
        )
    finally:
        os.close(handle)

    if result.returncode != 0:
        raise SetupError(
            "Sicherung fehlgeschlagen:\n%s" % result.stderr.decode(errors="replace")
        )

    with open(args.file) as dump:
        objects = sum(1 for line in dump if line.startswith("# file:"))
    if objects == 0:
        raise SetupError(
            "Es wurde kein einziges NT-ACL gefunden - die Sicherung waere leer.\n"
            "Wurde unter %s schon jemals ein Recht gesetzt?" % path
        )

    print()
    print("%d Objekte gesichert nach %s" % (objects, args.file))


def cmd_restore_acl(args):
    check_root()
    if not os.path.exists(args.file):
        raise SetupError("Datei %s existiert nicht." % args.file)

    with open(args.file) as dump:
        objects = sum(1 for line in dump if line.startswith("# file:"))
    if objects == 0:
        raise SetupError("%s enthaelt keine ACL-Eintraege." % args.file)

    result = run(["/usr/bin/setfattr", "--restore=%s" % args.file])
    if result.returncode != 0:
        raise SetupError("Wiederherstellung fehlgeschlagen:\n%s" % out(result))

    print()
    print("%d Objekte aus %s wiederhergestellt." % (objects, args.file))


def main():
    parser = argparse.ArgumentParser(
        description="Verwaltungs-Fileserver fuer linuxmuster.net 7.3"
    )
    subparsers = parser.add_subparsers(dest="command")

    setup_parser = subparsers.add_parser("setup", help="Server einrichten")
    setup_parser.add_argument("-d", "--domain", default="linuxmuster.lan")
    setup_parser.add_argument("-u", "--username", default="global-admin")
    setup_parser.add_argument(
        "-p",
        "--password",
        help="sonst interaktive Abfrage. Achtung: als Argument steht das "
        "Passwort in der Prozessliste und in der Shell-History - in Skripten "
        "besser --password-file verwenden",
    )
    setup_parser.add_argument(
        "-P", "--password-file", help="Datei, die das Passwort enthaelt"
    )
    setup_parser.add_argument("-s", "--share", default="Verwaltung")
    setup_parser.add_argument("--path", default="/srv/samba/verwaltung")
    setup_parser.add_argument(
        "-g",
        "--group",
        action="append",
        default=[],
        help="AD-Gruppe mit Zugriff auf die Freigabe (mehrfach angebbar)",
    )
    setup_parser.add_argument(
        "--rights-group",
        default="Domain Admins",
        help="AD-Gruppe, die die Rechte unter Windows verwalten darf",
    )
    setup_parser.add_argument(
        "--folder", action="append", default=[], help="anzulegender Unterordner"
    )
    setup_parser.add_argument(
        "--admin-user",
        action="store_true",
        help="Domaenen-Administrator als 'admin users' eintragen. Umgeht "
        "SAEMTLICHE Rechte auf der Freigabe - nur bewusst verwenden.",
    )

    status_parser = subparsers.add_parser("status", help="Zustand pruefen")
    status_parser.add_argument("-s", "--share", default="Verwaltung")

    show_parser = subparsers.add_parser("show", help="Freigabe und Rechte anzeigen")
    show_parser.add_argument("-s", "--share", default="Verwaltung")

    repair_parser = subparsers.add_parser(
        "repair-acls", help="Basis-ACL nach Gruppenwechsel erneuern"
    )
    repair_parser.add_argument("-u", "--username", default="global-admin")
    repair_parser.add_argument("-p", "--password")
    repair_parser.add_argument("-P", "--password-file", help="Datei mit dem Passwort")
    repair_parser.add_argument(
        "--force", action="store_true", help="auch ohne erkannte Aenderung setzen"
    )

    save_parser = subparsers.add_parser(
        "save-acl", help="alle NT-ACLs der Freigabe sichern"
    )
    save_parser.add_argument("-s", "--share", default="Verwaltung")
    save_parser.add_argument("-f", "--file", default="/root/verwaltung-ntacl.dump")

    restore_parser = subparsers.add_parser(
        "restore-acl", help="gesicherte NT-ACLs zurueckspielen"
    )
    restore_parser.add_argument("-s", "--share", default="Verwaltung")
    restore_parser.add_argument("-f", "--file", default="/root/verwaltung-ntacl.dump")

    args = parser.parse_args()
    print(BANNER)

    handlers = {
        "setup": cmd_setup,
        "status": cmd_status,
        "show": cmd_show,
        "repair-acls": cmd_repair_acls,
        "save-acl": cmd_save_acl,
        "restore-acl": cmd_restore_acl,
    }
    handler = handlers.get(args.command)
    if handler is None:
        parser.print_help()
        return

    try:
        handler(args)
    except SetupError as error:
        print()
        sys.exit(RED + str(error) + RESET)
    except KeyboardInterrupt:
        sys.exit("\nAbgebrochen.")
    except FileNotFoundError as error:
        # A missing Samba binary should read as a missing dependency, not as a
        # traceback.
        print()
        sys.exit(RED + "Programm nicht gefunden: %s" % error + RESET)
    except (OSError, IndexError, KeyError, configparser.Error) as error:
        print()
        sys.exit(
            RED
            + "Unerwarteter Fehler: %s: %s\n"
            "Falls %s von Hand bearbeitet wurde, pruefe die Datei."
            % (type(error).__name__, error, CONFIG_PATH)
            + RESET
        )


if __name__ == "__main__":
    main()
