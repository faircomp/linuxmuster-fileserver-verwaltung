# /etc/samba/smb.conf
#
# linuxmuster.net 7.3 - Verwaltungs-Fileserver (Active-Directory-Mitglied)
#
# Diese Datei wird von "linuxmuster-fileserver-verwaltung setup" aus einer
# Vorlage erzeugt. Die urspruengliche Datei liegt als smb.conf.lmn-orig
# daneben. Freigaben stehen bewusst NICHT hier, sondern in der Samba-Registry
# (siehe "registry shares" weiter unten).

[global]
  netbios name = %%HOSTNAME%%
  workgroup = %%WORKGROUP%%
  realm = %%DOMAIN%%
  security = ADS
  server string = Verwaltungs-Fileserver

  # Freigaben liegen in der Samba-Registry und werden mit "net conf" gepflegt.
  # Denselben Weg nutzt linuxmuster fuer die Schul-Shares. Vorteil: die
  # Definitionen ueberleben jedes Neuschreiben dieser Datei. Dafuer muss
  # registry.tdb mit ins Backup.
  registry shares = yes

  # --- ID-Mapping ------------------------------------------------------
  # sophomorix legt fuer Benutzer und Gruppen KEINE uidNumber/gidNumber im
  # AD an (im Quellcode von sophomorix4 geprueft). Damit scheidet das
  # "ad"-Backend mit RFC2307 aus - es wuerde jeden Benutzer ohne diese
  # Attribute schlicht unsichtbar machen.
  #
  # "rid" berechnet die Unix-ID deterministisch aus der RID des Kontos
  # (ID = RID - BASE_RID + LOW_RANGE_ID). Es braucht keinen persistenten
  # Zustand, und jeder Server mit dieser Konfiguration kommt auf dieselben
  # IDs - anders als das "autorid"-Backend des Standard-Fileservers, dessen
  # Bereiche von der Reihenfolge des Erstkontakts abhaengen.
  #
  # Die IDs stimmen NICHT mit denen des linuxmuster-Servers ueberein. Das ist
  # unkritisch, weil die Rechte auf diesem Server als NT-ACLs (SID-basiert)
  # gefuehrt werden. Bereiche nach der Inbetriebnahme nie mehr aendern.
  idmap config * : backend = tdb
  idmap config * : range = 3000-7999

  idmap config %%WORKGROUP%% : backend = rid
  idmap config %%WORKGROUP%% : range = 10000-999999

  # --- Kerberos / winbind ----------------------------------------------
  # Haelt neben secrets.tdb auch /etc/krb5.keytab aktuell. Der Pfad wird
  # bewusst nicht ueber "dedicated keytab file" gesetzt: dieser Parameter
  # wirkt laut Handbuch nur bei "kerberos method = dedicated keytab", und
  # /etc/krb5.keytab ist ohnehin der Kerberos-Standardpfad.
  kerberos method = secrets and keytab

  # AD-Benutzer sollen sich an diesem Server nicht anmelden koennen. Das ist
  # hier kein Detail: die Freigabe arbeitet mit
  # "acl_xattr:ignore system acls = yes", die POSIX-Rechte unterhalb der
  # Freigabe sind deshalb absichtlich wirkungslos. Ein lokaler Shell-Zugang
  # wuerde die Windows-Rechte vollstaendig umgehen. Auf den SMB-Zugriff hat
  # das keinen Einfluss - smbd wertet die Login-Shell nie aus.
  template shell = /usr/sbin/nologin
  template homedir = /dev/null

  # Hier stand einmal "username map = /etc/samba/user.map" mit einer
  # Zuordnung des Domaenen-Administrators auf root. Das ist eine Empfehlung
  # fuer Domaenencontroller - auf einem MITGLIEDSSERVER bricht sie den
  # Session-Setup vollstaendig: jede SMB-Anmeldung scheitert dann mit
  # NT_STATUS_INVALID_TOKEN, auch die des Administrators. Am realen System
  # verifiziert. Nicht wieder einbauen.
  #
  # Fuer "net rpc rights" wird sie nicht gebraucht: Mitglieder der
  # Domaenen-Admins bekommen auf einem Mitgliedsserver ohnehin die SID
  # BUILTIN\Administrators in ihr Token.

  # --- Windows-ACLs ------------------------------------------------------
  # Speichert den vollstaendigen NT-Security-Descriptor im erweiterten
  # Attribut security.NTACL. Die share-spezifischen acl_xattr-Optionen
  # stehen bei der Freigabe selbst (net conf), nicht hier.
  #
  # "map acl inherit" fehlt hier absichtlich: es gehoert zur Abbildung auf
  # POSIX-Draft-ACLs, die von "acl_xattr:ignore system acls = yes" gerade
  # abgeschaltet wird. Ebenso ueberfluessig sind "inherit acls" und
  # create/directory mask - die erzwingt das Modul selbst.
  vfs objects = acl_xattr

  # --- Dies ist kein Druckserver -----------------------------------------
  load printers = no
  printing = bsd
  printcap name = /dev/null
  disable spoolss = yes

  # --- Protokollierung ----------------------------------------------------
  log level = 1
  max log size = 10000
  logging = file
