# Name Service Switch for the linuxmuster.net administration fileserver:
# the Ubuntu 24.04 default (/etc/nsswitch.conf from base-files) with "winbind"
# appended to passwd and group, so that domain users and groups resolve on this
# host. `linuxmuster-fileserver-verwaltung setup` installs it as
# /etc/nsswitch.conf.

passwd:         files systemd winbind
group:          files systemd winbind
shadow:         files
gshadow:        files

hosts:          files dns
networks:       files

protocols:      db files
services:       db files
ethers:         db files
rpc:            db files

netgroup:       nis
